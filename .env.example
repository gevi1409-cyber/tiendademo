# ── Tienda demo · copia este archivo a .env ─────────────────────────────────────
# mock  = simula a Alpha (sin credenciales, para trabajar la UI)
# alpha = sesiones reales contra el sandbox de Alpha
MODO=mock
PUERTO=5443

# Origen EXACTO con el que abres la tienda en el navegador. Es el parentOrigin de la sesión y
# tiene que estar dado de alta en la CA (Integraciones / Checkout → Orígenes) para el MID.
# Alpha sólo acepta https. En local: https://localhost:5443 (con certificado, ver README) o la URL del túnel.
TIENDA_ORIGEN=https://localhost:5443

# Certificado local para servir https (opcional; sin él la tienda corre en http, válido sólo en mock)
HTTPS_CERT=certs/localhost.pem
HTTPS_KEY=certs/localhost-key.pem

# ── Sólo MODO=alpha ─────────────────────────────────────────────────────────────
# Base del API de Alpha del ambiente sandbox (la misma que gateway_url de la CA en dev)
ALPHA_API_URL=https://dev.gateway.alphaconnect.efevoo.app
# Key checkout del MID emitida desde la CA (CA-02). NUNCA la subas al repo ni la pongas en el front.
ALPHA_CHECKOUT_KEY=
# URL del SDK publicado por Alpha. Si se deja vacío: ALPHA_API_URL + /alpha-checkout.js
ALPHA_CHECKOUT_JS=https://dev.gateway.alphaconnect.efevoo.app/alpha-checkout.js

# Firma los tokens de pedido (HMAC). Obligatorio en MODO=alpha en Vercel; en local se genera uno al arrancar.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TIENDA_SECRETO=

MONEDA=MXN
# Vigencia de la sesión en minutos (siempre se manda expiresAt)
VIGENCIA_MIN=30
